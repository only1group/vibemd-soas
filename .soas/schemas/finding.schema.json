{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibemd.example/soas/schemas/finding.schema.json",
  "title": "SOAS Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "title", "description", "severity", "confidence", "priority", "status",
    "affected_scope", "evidence", "risk", "impact", "authoritative_basis",
    "remediation", "verification", "owner"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^SOAS-F-[0-9]{4,}$"},
    "title": {"type": "string", "minLength": 3},
    "description": {"type": "string", "minLength": 10},
    "severity": {"enum": ["critical", "high", "medium", "low", "informational"]},
    "confidence": {"enum": ["confirmed", "high", "medium", "low"]},
    "priority": {"enum": ["immediate", "next-release", "planned", "backlog", "none"]},
    "status": {
      "enum": ["open", "planned", "in-progress", "ready-for-verification", "closed", "accepted-risk", "reopened"]
    },
    "affected_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "environments", "populations"],
      "properties": {
        "components": {"type": "array", "items": {"type": "string"}},
        "environments": {"type": "array", "items": {"type": "string"}},
        "populations": {"type": "array", "items": {"type": "string"}},
        "tenancies": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "source", "location", "observed_at", "subject_version", "reproducibility"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["test-result", "runtime-observation", "configuration", "source", "document", "statement", "inference"]},
          "source": {"type": "string"},
          "location": {"type": "string"},
          "observation": {"type": "string"},
          "observed_at": {"type": "string", "format": "date-time"},
          "subject_version": {"type": "string"},
          "reproducibility": {"enum": ["reproduced", "reproducible", "not-reproduced", "not-applicable"]},
          "integrity_hash": {"type": "string"},
          "limitations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario", "likelihood", "exposure"],
      "properties": {
        "scenario": {"type": "string"},
        "likelihood": {"enum": ["almost-certain", "likely", "possible", "unlikely", "rare", "unknown"]},
        "exposure": {"enum": ["public", "partner", "internal", "local", "none", "unknown"]}
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "potential"],
      "properties": {
        "observed": {"type": ["string", "null"]},
        "potential": {"type": "string"},
        "reversibility": {"enum": ["easy", "moderate", "difficult", "irreversible", "unknown"]}
      }
    },
    "authoritative_basis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["standard_id", "version", "reference", "relationship"],
        "properties": {
          "standard_id": {"type": "string"},
          "version": {"type": "string"},
          "reference": {"type": "string"},
          "relationship": {"enum": ["normative", "advisory", "contextual"]}
        }
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendation", "acceptance_criteria"],
      "properties": {
        "recommendation": {"type": "string"},
        "acceptance_criteria": {"type": "array", "items": {"type": "string"}}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["procedure", "required_evidence"],
      "properties": {
        "procedure": {"type": "string"},
        "required_evidence": {"type": "array", "items": {"type": "string"}},
        "result": {"enum": ["passed", "failed", "inconclusive", "not-run"]},
        "verified_at": {"type": "string", "format": "date-time"},
        "verifier": {"type": "string"},
        "independence": {"enum": ["independent", "separate-context", "self-verified"]},
        "regression_evidence": {"type": "array", "items": {"type": "string"}},
        "residual_risk": {"type": "string"},
        "reopen_conditions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {"enum": ["assigned", "unassigned", "unknown"]},
        "identity": {"type": "string"},
        "role": {"type": "string"}
      }
    },
    "risk_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approver", "rationale", "expires_at"],
      "properties": {
        "approver": {"type": "string"},
        "rationale": {"type": "string"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "closed"}}, "required": ["status"]},
      "then": {
        "properties": {
          "verification": {
            "required": ["result", "verified_at", "verifier", "independence", "regression_evidence", "residual_risk", "reopen_conditions"],
            "properties": {"result": {"const": "passed"}}
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "accepted-risk"}}, "required": ["status"]},
      "then": {"required": ["risk_acceptance"]}
    }
  ]
}
